# Copy to .env.local and adjust. All of these are optional for local work.
# NEXT_PUBLIC_ values are baked in when the app is built, so rebuild after changing them.

# Where the backend API runs.
NEXT_PUBLIC_API_URL=http://localhost:8000

# "true" turns on sign-in (Supabase). Anything else, or unset, means no sign-in and
# no token is sent; match the backend's AUTH_ENABLED.
NEXT_PUBLIC_AUTH_ENABLED=false

# Needed only when NEXT_PUBLIC_AUTH_ENABLED=true. From the Supabase dashboard:
# Project Settings > API (project URL and the anon/public key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
